//@version=6
// ============================================================================
// OpenSourceEdge - Build Order #01: Shield Battery (Long-Gamma Drift, TV v6)
// ============================================================================
// Author:  @OpenSourceEdge
// License: MIT (Free to use, modify, fork, and backtest)
// Chart:   MNQ1! (or NQ1!) on 1-Minute timeframe
// Scouted on 1B+ real ticks & 32M options rows. Strictly causal. No map hacks.
//
// TWO REGIME MODES:
// 1. "Auto Free Proxy (VIX/VIX3M)" [Default for Instant Backtesting]:
//    Uses strictly causal prior-day CBOE:VIX / CBOE:VIX3M < 0.98 (plus optional
//    VIX9D/VIX < 1.05 veto) right inside TradingView so you can backtest with
//    zero external files. Note: the primary 8-year research used strike-level
//    SPX 14-DTE Gamma Flip (32M OPRA rows).
// 2. "Live Manual Gamma Flip" [Recommended for Daily Live Alerts]:
//    Enter today's pre-market SPX Gamma Flip (or toggle Positive Gamma Today)
//    each morning before 09:30 ET. Fires clean 13:00 ET entry + stop alerts
//    and 15:55 ET exit alerts for 10-second manual prop-firm execution.
// ============================================================================

strategy(
    "OpenSourceEdge: Shield Battery (Long-Gamma 13:00)",
    shorttitle = "OSE Shield Battery",
    overlay = true,
    initial_capital = 50000,
    default_qty_type = strategy.fixed,
    default_qty_value = 1,
    commission_type = strategy.commission.cash_per_contract,
    commission_value = 0.62,
    slippage = 1,
    calc_on_every_tick = false,
    process_orders_on_close = false
)

// --- Inputs ---
grpReg = "1. Dealer Gamma Regime"
regimeMode     = input.string("Auto Free Proxy (VIX/VIX3M)", "Regime Mode",
                 options = ["Auto Free Proxy (VIX/VIX3M)", "Live Manual Gamma Flip"], group = grpReg)
vixRatioMax    = input.float(0.98, "Proxy: Max Prior-Day VIX/VIX3M", step = 0.01, minval = 0.70, maxval = 1.20, group = grpReg)
useVix9dVeto   = input.bool(true, "Skip VIX9D/VIX >= 1.05 (Short-Term Vol Stress)", group = grpReg)
vix9dMax       = input.float(1.05, "Max Prior-Day VIX9D/VIX", step = 0.01, minval = 0.80, maxval = 1.50, group = grpReg)
manualPosGamma = input.bool(true, "Live Mode: Positive Gamma Today (ES Open > SPX Flip)", group = grpReg)

grpSig = "2. Signal & Risk"
checkHourEt    = input.int(13, "Check Hour (ET)", minval = 12, maxval = 15, group = grpSig)
checkMinEt     = input.int(0,  "Check Minute (ET)", minval = 0, maxval = 59, group = grpSig)
exitHourEt     = input.int(15, "Flat Hour (ET)", minval = 13, maxval = 15, group = grpSig)
exitMinEt      = input.int(55, "Flat Minute (ET)", minval = 0, maxval = 59, group = grpSig)
stopAtrMult    = input.float(2.0, "Stop Loss (ATR 15m Multiple)", step = 0.25, minval = 0.5, maxval = 5.0, group = grpSig)
minStopTicks   = input.int(16, "Min Stop (Ticks)", minval = 4, maxval = 200, group = grpSig)
maxStopPoints  = input.float(200.0, "Max Stop Cap (Points, 0 = Off)", minval = 0.0, group = grpSig)
skipFomc       = input.bool(true, "Skip Scheduled FOMC Days (2024-2026)", group = grpSig)

grpUi = "3. Display"
showTable      = input.bool(true, "Show Status Panel", group = grpUi)

// --- Strictly Causal Prior-Day CBOE Term Structure (Zero Lookahead) ---
vixPrev   = request.security("CBOE:VIX",   "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
vix3mPrev = request.security("CBOE:VIX3M", "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
vix9dPrev = request.security("CBOE:VIX9D", "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

vixRatio   = (not na(vixPrev) and not na(vix3mPrev) and vix3mPrev > 0) ? (vixPrev / vix3mPrev) : na
vix9dRatio = (not na(vix9dPrev) and not na(vixPrev) and vixPrev > 0) ? (vix9dPrev / vixPrev) : na

// Causal 15-minute ATR (14-bar SMA of 15m True Range, using closed 15m bar)
atr15m = request.security(syminfo.tickerid, "15", ta.sma(ta.tr(true), 14)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// --- Eastern Time Session Clock ---
etYear   = year(time_close, "America/New_York")
etMonth  = month(time_close, "America/New_York")
etDay    = dayofmonth(time_close, "America/New_York")
etHour   = hour(time_close, "America/New_York")
etMin    = minute(time_close, "America/New_York")
etTotalM = etHour * 60 + etMin
dayKey   = etYear * 10000 + etMonth * 100 + etDay

isRth = etTotalM > (9 * 60 + 30) and etTotalM <= (16 * 60)
isNewRthDay = isRth and not isRth[1] and (na(dayKey[1]) or dayKey != dayKey[1] or etTotalM <= 9 * 60 + 35)

// Built-in Scheduled FOMC Decision Dates (2024-2026)
f_isFomc(int dk) =>
    dk == 20240131 or dk == 20240320 or dk == 20240501 or dk == 20240612 or
    dk == 20240731 or dk == 20240918 or dk == 20241107 or dk == 20241218 or
    dk == 20250129 or dk == 20250319 or dk == 20250507 or dk == 20250618 or
    dk == 20250730 or dk == 20250917 or dk == 20251029 or dk == 20251210 or
    dk == 20260128 or dk == 20260318 or dk == 20260429 or dk == 20260617 or
    dk == 20260729 or dk == 20260916 or dk == 20261028 or dk == 20261209

isFomcDay = skipFomc and f_isFomc(dayKey)

// --- RTH VWAP Calculation (Anchored strictly at 09:30 ET) ---
var float cumPV = na
var float cumV  = na
var bool  tradedToday = false
var float activeStop  = na

if isNewRthDay
    cumPV := 0.0
    cumV  := 0.0
    tradedToday := false
    activeStop  := na

if isRth
    tp = (high + low + close) / 3.0
    vol = math.max(volume, 0.0)
    cumPV += tp * vol
    cumV  += vol

rthVwap = (isRth and cumV > 0) ? (cumPV / cumV) : na

// --- Regime Qualification ---
proxyPosGamma = not na(vixRatio) and vixRatio < vixRatioMax
isPosGamma    = regimeMode == "Live Manual Gamma Flip" ? manualPosGamma : proxyPosGamma
vix9dBlocked  = useVix9dVeto and not na(vix9dRatio) and vix9dRatio >= vix9dMax
regimeAllowed = isPosGamma and not isFomcDay and not vix9dBlocked

// --- Entry & Exit Logic ---
checkTargetMin = checkHourEt * 60 + checkMinEt
exitTargetMin  = exitHourEt * 60 + exitMinEt

isCheckBar = isRth and etTotalM == checkTargetMin
isExitBar  = isRth and etTotalM >= exitTargetMin

rawStopDist = not na(atr15m) ? (stopAtrMult * atr15m) : na
minStopDist = minStopTicks * syminfo.mintick
stopDist    = na(rawStopDist) ? na : math.max(minStopDist, rawStopDist)
if maxStopPoints > 0 and not na(stopDist)
    stopDist := math.min(stopDist, maxStopPoints)

longSignal = isCheckBar and not tradedToday and strategy.position_size == 0 and regimeAllowed and not na(rthVwap) and close > rthVwap and not na(stopDist)

if longSignal
    stopPrice = close - stopDist
    activeStop := stopPrice
    tradedToday := true
    strategy.entry("LG Long", strategy.long, comment = "OSE PosGamma 13:00")
    strategy.exit("LG Stop", from_entry = "LG Long", stop = stopPrice)
    alert("OpenSourceEdge Ep.1 SIGNAL LONG: " + syminfo.ticker + " at " + str.tostring(close, format.mintick) +
          " | Hard Stop: " + str.tostring(stopPrice, format.mintick) + " | Flat 15:55 ET", alert.freq_once_per_bar_close)

if strategy.position_size > 0 and isExitBar
    strategy.close("LG Long", comment = "Flat 15:55 ET")
    activeStop := na
    alert("OpenSourceEdge Ep.1 FLAT 15:55 ET: Close " + syminfo.ticker + " long position.", alert.freq_once_per_bar_close)

if strategy.position_size == 0 and not longSignal
    activeStop := na

// --- Clean Dark-Mode Visuals ---
plot(rthVwap, "RTH VWAP", color = color.new(#2DD4BF, 20), linewidth = 2, style = plot.style_linebr)
plot(activeStop, "Hard Stop (2x ATR15)", color = color.new(#F87171, 15), linewidth = 2, style = plot.style_linebr)
plotshape(longSignal, title = "13:00 Pos-Gamma Signal", style = shape.triangleup, location = location.belowbar,
          color = #2DD4BF, size = size.small, text = "LG", textcolor = #F3F5F8)

// --- Minimal Status Panel ---
if showTable and barstate.islast
    var table tbl = table.new(position.top_right, 2, 5, bgcolor = color.new(#0B0E14, 10), border_color = #1E293B, border_width = 1)
    table.cell(tbl, 0, 0, "OpenSourceEdge", text_color = #F3F5F8, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 0, "Ep. 1 LG Drift", text_color = #2DD4BF, text_size = size.small, text_halign = text.align_right)
    table.cell(tbl, 0, 1, "Gamma Regime", text_color = #94A3B8, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tbl, 1, 1, isPosGamma ? "POSITIVE" : "NEGATIVE", text_color = isPosGamma ? #2DD4BF : #F87171, text_size = size.tiny, text_halign = text.align_right)
    table.cell(tbl, 0, 2, "VIX / VIX3M", text_color = #94A3B8, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tbl, 1, 2, na(vixRatio) ? "N/A" : str.tostring(vixRatio, "#.##"), text_color = #F3F5F8, text_size = size.tiny, text_halign = text.align_right)
    table.cell(tbl, 0, 3, "VIX9D / VIX", text_color = #94A3B8, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tbl, 1, 3, na(vix9dRatio) ? "N/A" : str.tostring(vix9dRatio, "#.##"), text_color = vix9dBlocked ? #F87171 : #F3F5F8, text_size = size.tiny, text_halign = text.align_right)
    table.cell(tbl, 0, 4, "13:00 Status", text_color = #94A3B8, text_size = size.tiny, text_halign = text.align_left)
    statusTxt = isFomcDay ? "SKIP (FOMC)" : (vix9dBlocked ? "SKIP (VOL)" : (regimeAllowed ? "ARMED" : "OFF"))
    table.cell(tbl, 1, 4, statusTxt, text_color = regimeAllowed ? #2DD4BF : #94A3B8, text_size = size.tiny, text_halign = text.align_right)
