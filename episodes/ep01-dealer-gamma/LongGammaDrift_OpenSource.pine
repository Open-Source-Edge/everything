//@version=6
// ============================================================================
// OpenSourceEdge - Build Order #01: Shield Battery (Long-Gamma Drift, TV v6)
// ============================================================================
// Author:  @OpenSourceEdge
// License: MIT (Free to use, modify, fork, and backtest)
// Chart:   MNQ1! (or NQ1!) on the 1-Minute timeframe
// Scouted on 1B+ real ticks & 32M options rows. Strictly causal. No map hacks.
//
// QUICK START (BEGINNERS):
// 1. Open MNQ1! on a 1-Minute chart and add this script.
// 2. Default mode ("Auto Free Proxy") works immediately with zero setup.
// 3. To get phone pings at 13:00 ET (entry + exact stop) and 15:55 ET (flat):
//    Alerts clock -> Condition: OSE Shield Battery -> Order fills and alert()
//    function calls -> Create.
// 4. Optional Pro Mode ("Live Manual Gamma Flip"): toggle Positive Gamma Today
//    before 09:30 ET using pre-market SPX 14-DTE Gamma Flip data.
// ============================================================================

strategy("OpenSourceEdge: Shield Battery (Long-Gamma 13:00)", shorttitle = "OSE Shield Battery", overlay = true, initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1, calc_on_every_tick = false, process_orders_on_close = false)

// --- Inputs ---
grpReg = "1. Dealer Gamma Regime"
regimeMode     = input.string("Auto Free Proxy (VIX/VIX3M)", "Regime Mode", options = ["Auto Free Proxy (VIX/VIX3M)", "Live Manual Gamma Flip"], group = grpReg)
vixRatioMax    = input.float(0.98, "Proxy: Max Prior-Day VIX/VIX3M", step = 0.01, minval = 0.70, maxval = 1.20, group = grpReg)
useVix9dVeto   = input.bool(true, "Skip VIX9D/VIX >= 1.05 (Short-Term Vol Stress)", group = grpReg)
vix9dMax       = input.float(1.05, "Max Prior-Day VIX9D/VIX", step = 0.01, minval = 0.80, maxval = 1.50, group = grpReg)
manualPosGamma = input.bool(true, "Live Mode: Positive Gamma Today (ES Open > SPX Flip)", group = grpReg)

grpSig = "2. Signal & Risk"
checkHourEt    = input.int(13, "Check Hour (ET)", minval = 12, maxval = 15, group = grpSig)
checkMinEt     = input.int(0,  "Check Minute (ET)", minval = 0, maxval = 59, group = grpSig)
exitHourEt     = input.int(15, "Flat Hour (ET)", minval = 13, maxval = 15, group = grpSig)
exitMinEt      = input.int(55, "Flat Minute (ET)", minval = 0, maxval = 59, group = grpSig)
stopAtrMult    = input.float(2.0, "Stop Loss (ATR 15m Multiple)", step = 0.25, minval = 0.5, maxval = 5.0, group = grpSig)
minStopTicks   = input.int(16, "Min Stop (Ticks)", minval = 4, maxval = 200, group = grpSig)
maxStopPoints  = input.float(200.0, "Max Stop Cap (Points, 0 = Off)", minval = 0.0, group = grpSig)
skipFomc       = input.bool(true, "Skip Scheduled FOMC Days (2024-2026)", group = grpSig)

grpUi = "3. Display"
showTable      = input.bool(true, "Show Plain-English Status Panel", group = grpUi)

// --- Strictly Causal Prior-Day CBOE Term Structure (Zero Lookahead) ---
vixPrev   = request.security("CBOE:VIX",   "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
vix3mPrev = request.security("CBOE:VIX3M", "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
vix9dPrev = request.security("CBOE:VIX9D", "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

vixRatio   = (not na(vixPrev) and not na(vix3mPrev) and vix3mPrev > 0) ? (vixPrev / vix3mPrev) : na
vix9dRatio = (not na(vix9dPrev) and not na(vixPrev) and vixPrev > 0) ? (vix9dPrev / vixPrev) : na

// Causal 15-minute ATR (14-bar SMA of 15m True Range, using closed 15m bar)
atr15m = request.security(syminfo.tickerid, "15", ta.sma(ta.tr(true), 14)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// --- Eastern Time Session Clock ---
etYear   = year(time_close, "America/New_York")
etMonth  = month(time_close, "America/New_York")
etDay    = dayofmonth(time_close, "America/New_York")
etHour   = hour(time_close, "America/New_York")
etMin    = minute(time_close, "America/New_York")
etTotalM = etHour * 60 + etMin
dayKey   = etYear * 10000 + etMonth * 100 + etDay

isValidTf   = timeframe.isintraday and (timeframe.multiplier == 1 or timeframe.multiplier == 5)
isRth       = etTotalM > (9 * 60 + 30) and etTotalM <= (16 * 60)
isNewRthDay = isRth and not isRth[1] and (na(dayKey[1]) or dayKey != dayKey[1] or etTotalM <= 9 * 60 + 35)

// Built-in Scheduled FOMC Decision Dates (2024-2026)
var array<int> fomcDates = array.from(20240131, 20240320, 20240501, 20240612, 20240731, 20240918, 20241107, 20241218, 20250129, 20250319, 20250507, 20250618, 20250730, 20250917, 20251029, 20251210, 20260128, 20260318, 20260429, 20260617, 20260729, 20260916, 20261028, 20261209)
isFomcDay = skipFomc and array.includes(fomcDates, dayKey)

// --- RTH VWAP Calculation (Anchored strictly at 09:30 ET) ---
var float cumPV       = na
var float cumV        = na
var bool  tradedToday = false
var float activeStop  = na

if isNewRthDay
    cumPV       := 0.0
    cumV        := 0.0
    tradedToday := false
    activeStop  := na

if isRth
    tp  = (high + low + close) / 3.0
    vol = math.max(volume, 0.0)
    cumPV += tp * vol
    cumV  += vol

rthVwap = (isRth and cumV > 0) ? (cumPV / cumV) : na

// --- Regime Qualification ---
isManualMode  = regimeMode == "Live Manual Gamma Flip"
proxyPosGamma = not na(vixRatio) and vixRatio < vixRatioMax
isPosGamma    = isManualMode ? manualPosGamma : proxyPosGamma
vix9dBlocked  = useVix9dVeto and not na(vix9dRatio) and vix9dRatio >= vix9dMax
regimeAllowed = isPosGamma and not isFomcDay and not vix9dBlocked

// --- Entry & Exit Logic ---
checkTargetMin = checkHourEt * 60 + checkMinEt
exitTargetMin  = exitHourEt * 60 + exitMinEt

isCheckBar = isValidTf and isRth and etTotalM == checkTargetMin
isExitBar  = isRth and etTotalM >= exitTargetMin

rawStopDist = not na(atr15m) ? (stopAtrMult * atr15m) : na
minStopDist = minStopTicks * syminfo.mintick
stopDist    = na(rawStopDist) ? na : math.max(minStopDist, rawStopDist)
if maxStopPoints > 0 and not na(stopDist)
    stopDist := math.min(stopDist, maxStopPoints)

longSignal = isCheckBar and not tradedToday and strategy.position_size == 0 and regimeAllowed and not na(rthVwap) and close > rthVwap and not na(stopDist)

if longSignal
    stopPrice   = close - stopDist
    activeStop  := stopPrice
    tradedToday := true
    strategy.entry("LG Long", strategy.long, comment = "Shield Battery 13:00")
    strategy.exit("LG Stop", from_entry = "LG Long", stop = stopPrice)
    alert("OpenSourceEdge Shield Battery BUY 13:00: " + syminfo.ticker + " at " + str.tostring(close, format.mintick) + " | Hard Stop: " + str.tostring(stopPrice, format.mintick) + " (" + str.tostring(stopDist, "#.##") + " pts) | Flat 15:55 ET", alert.freq_once_per_bar_close)

if strategy.position_size > 0 and isExitBar
    strategy.close("LG Long", comment = "Flat 15:55 ET")
    activeStop := na
    alert("OpenSourceEdge Shield Battery FLAT 15:55 ET: Close " + syminfo.ticker + " long position.", alert.freq_once_per_bar_close)

if strategy.position_size == 0 and not longSignal
    activeStop := na

// --- Clean Dark-Mode Visuals ---
plot(rthVwap, "RTH VWAP (Must Close Above at 13:00 ET)", color = color.new(#2DD4BF, 20), linewidth = 2, style = plot.style_linebr)
plot(activeStop, "Hard Stop (2x ATR15)", color = color.new(#F87171, 15), linewidth = 2, style = plot.style_linebr)
plotshape(longSignal, title = "Shield Battery Buy Signal", style = shape.triangleup, location = location.belowbar, color = #2DD4BF, size = size.small, text = "BUY 13:00", textcolor = #F3F5F8)

// --- Dummy-Proof Plain-English Status Panel (Readable Size) ---
var table tbl = table.new(position.top_right, 2, 6, bgcolor = color.new(#0B0E14, 6), border_color = #334155, border_width = 1, frame_color = #334155, frame_width = 1)
if showTable and barstate.islast
    actionTxt = not isValidTf ? "USE 1M OR 5M CHART" : (strategy.position_size > 0 ? "IN LONG (FLAT 15:55)" : (tradedToday ? "DONE FOR TODAY" : (isFomcDay ? "SKIP TODAY (FOMC)" : (vix9dBlocked ? "SKIP (VOL STRESS)" : (not isPosGamma ? "SKIP (NEG GAMMA)" : (isRth and etTotalM > checkTargetMin ? "NO SIGNAL TODAY" : "WATCH 13:00 ET"))))))
    actionCol = not isValidTf ? #F87171 : (strategy.position_size > 0 or actionTxt == "WATCH 13:00 ET" ? #2DD4BF : #94A3B8)
    modeTxt   = isManualMode ? "MANUAL FLIP" : (na(vixRatio) ? "N/A" : str.tostring(vixRatio, "#.##") + " (VIX/3M)")
    stopTxt   = not na(activeStop) ? str.tostring(activeStop, format.mintick) : (na(stopDist) ? "N/A" : str.tostring(stopDist, "#.##") + " pts")
    stopLbl   = not na(activeStop) ? "Active Hard Stop" : "Est. Stop (2x ATR)"

    table.cell(tbl, 0, 0, "OpenSourceEdge", text_color = #F3F5F8, text_size = size.large, text_halign = text.align_left)
    table.cell(tbl, 1, 0, "Shield Battery", text_color = #2DD4BF, text_size = size.large, text_halign = text.align_right)
    table.cell(tbl, 0, 1, "Today's Action", text_color = #94A3B8, text_size = size.normal, text_halign = text.align_left)
    table.cell(tbl, 1, 1, actionTxt, text_color = actionCol, text_size = size.normal, text_halign = text.align_right)
    table.cell(tbl, 0, 2, "Dealer Gamma", text_color = #94A3B8, text_size = size.normal, text_halign = text.align_left)
    table.cell(tbl, 1, 2, isPosGamma ? "POSITIVE (SHIELDS ON)" : "NEGATIVE (OFFLINE)", text_color = isPosGamma ? #2DD4BF : #F87171, text_size = size.normal, text_halign = text.align_right)
    table.cell(tbl, 0, 3, "Regime Input", text_color = #94A3B8, text_size = size.normal, text_halign = text.align_left)
    table.cell(tbl, 1, 3, modeTxt, text_color = #F3F5F8, text_size = size.normal, text_halign = text.align_right)
    table.cell(tbl, 0, 4, stopLbl, text_color = #94A3B8, text_size = size.normal, text_halign = text.align_left)
    table.cell(tbl, 1, 4, stopTxt, text_color = not na(activeStop) ? #F87171 : #F3F5F8, text_size = size.normal, text_halign = text.align_right)
    table.cell(tbl, 0, 5, "Rule", text_color = #94A3B8, text_size = size.normal, text_halign = text.align_left)
    table.cell(tbl, 1, 5, "MNQ 1m/5m · > VWAP", text_color = #CBD5E1, text_size = size.normal, text_halign = text.align_right)
